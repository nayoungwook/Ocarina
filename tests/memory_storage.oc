var flag: bool = true;
var letter: char = 65;
var integer: int = -7;
var real: float = 1;
var precise: double = 2;
var direction: vector = initial_direction();
var text: string = "packed";

func initial_direction(): vector {
    return vector(3, 4, 5);
}

object Base {
    var flag: bool = true;
    var letter: char = 66;
    var integer: int = -8;
}

object Packed extends Base {
    var real: float = 1;
    var precise: double = 2;
    var direction: vector;
    var text: string = "object";

    constructor Packed(value: double) {
        precise = value;
    }

    func apply_values(value: float): double {
        real = value;
        real++;
        precise += 0.5;
        integer--;
        direction = 2;
        return integer;
    }
}

func arguments(flag: bool, letter: char, integer: int, real: float,
               precise: double, direction: vector, text: string): void {
    print("args:", flag, ",", letter, ",", integer, ",", real, ",",
          precise, ",", direction, ",", text, "\n");
}

func result(value: int): double {
    if (value == 0) {
        return 1;
    }
    return result(value - 1) + 1;
}

func main(): void {
    print("globals:", flag, ",", letter, ",", integer, ",", real, ",",
          precise, ",", direction, ",", text, "\n");
    var b: bool = false;
    var c: char = 67;
    var i: int = -9;
    var f: float = 3;
    var d: double = 1 + 0.5;
    var v: vector;
    var s: string = "local";
    print("locals:", b, ",", c, ",", i, ",", f, ",", d, ",", v, ",", s, "\n");
    b = 8;
    c = 68;
    i = 1.5 + 2;
    i += 0.75;
    f = 1 + 0.25;
    d = 1 + 0.5f;
    v = 2;
    arguments(b, c, i, f, d, v, s);
    arguments(true, 69, 4.75, 5, 6, 7, "converted");
    var receiver: Packed = new Packed(3);
    var returned: double = receiver.apply_values(4);
    print("object:", receiver.flag, ",", receiver.letter, ",", receiver.integer, ",",
          receiver.real, ",", receiver.precise, ",", receiver.direction, ",",
          receiver.text, ",", returned, "\n");
    var base: Base = receiver;
    var missing: Packed;
    var missing_text: string;
    print("refs:", base == receiver, ",", missing == null, ",",
          missing_text == null, "\n");
    print("recursive:", result(32), "\n");
}
