var receiver_calls: int = 0;
var child_calls: int = 0;

object Group {
    var value: int = 1;

    func attach(child: Item): void {
        add_child(child);
    }
}

object DerivedGroup extends Group {}

object Item {
    var value: int;

    constructor Item(initial: int) {
        value = initial;
    }
}

var group: Group = new Group();
var item: Item = new Item(0);

func receiver(): Group {
    receiver_calls += 1;
    return group;
}

func child(): Item {
    child_calls += 1;
    return item;
}

object Container {
    var nested: Group = new Group();

    constructor Container() {
        add_child(nested);
        nested.add_child(new Item(0));
    }
}

func main(): void {
    receiver().add_child(child());
    group.add_child(item);
    var derived: DerivedGroup = new DerivedGroup();
    derived.attach(item);
    var container: Container = new Container();
    container.nested.add_child(derived);
    item.value = 42;
    print("attached:", group.value, ",", item.value, ",", derived.value, ",",
          receiver_calls, ",", child_calls, "\n");
    for (var i:int = 0; i < 2048; i++) {
        group.add_child(new Item(0));
    }
    print("stable:", item.value, ",", group.value, "\n");
}
