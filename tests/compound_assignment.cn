var global_value: int = 20;
var receiver_calls: int = 0;

object Counter {
    var value: int = 20;
    var secondary: int = 20;

    func update(): void {
        value += 10;
        value -= 6;
        value *= 3;
        value /= 4;
        value %= 5;
    }
}

object Holder {
    var child: Counter = new Counter();
}

var counter: Counter = new Counter();

func receiver(): Counter {
    receiver_calls += 1;
    return counter;
}

func main(): void {
    var local: int = 20;
    local += 10;
    local -= 6;
    local *= 3;
    local /= 4;
    local %= 5;
    global_value += 10;
    global_value -= 6;
    global_value *= 3;
    global_value /= 4;
    global_value %= 5;
    counter.update();
    print("scopes:", local, ",", global_value, ",", counter.value, "\n");

    receiver().value += 10;
    receiver().value -= 6;
    receiver().value *= 3;
    receiver().value /= 4;
    receiver().value %= 5;
    print("member:", counter.value, ",", receiver_calls, "\n");

    counter.secondary += 3;
    counter.value += 4;
    var holder: Holder = new Holder();
    holder.child.value %= 6;
    print("nested:", counter.secondary, ",", counter.value, ",", holder.child.value, "\n");

    var v: vector = vector(2, 2);
    for (var step: int = 0; step < 10; step += 1) {
        v += vector(3, 3);
    }
    v -= vector(2, 2);
    v *= 2;
    v /= vector(3, 3, 1);
    v %= vector(7, 7, 1);
    print("vector:", v, "\n");

    var f: float = 10.0f;
    f += 2.0f;
    f -= 1.0f;
    f *= 3.0f;
    f /= 2.0f;
    f %= 5.0f;
    var d: double = 5.5;
    d += 1;
    d -= 0.5;
    d *= 3;
    d /= 2;
    d %= 4;
    print("real:", f, ",", d, "\n");

    var a: int = 1;
    var b: int = 3;
    a += b *= 2;
    var typed: int = a += 2;
    var remainder: int = 17 % 5;
    print("expression:", a, ",", b, ",", typed, ",", remainder, ",", 2 + 17 % 5 * 3, ",", -17 % 5, "\n");

    // Read the old left value before evaluating a right side that updates it.
    var order: int = 5;
    order += (order = 10);
    print("order:", order, "\n");
}
