var global_cast:int = cast<int>(9.9);
var calls:int = 0;

func next_value():double { calls++; return 5.8; }
func take_int(value:int):int { return value; }
func return_cast(value:double):int { return cast<int>(value); }

object Base {
    var a:int = 10;
    func identify():int { return 1; }
}

object Middle extends Base { var b:int = 20; }

object Leaf extends Middle {
    var c:int = 30;
    func identify():int { return 3; }
    func total():int { return a + b + c; }
}

func main():void {
    print("numeric:", cast<int>(3.9), ",", cast<int>(-3.9), ",",
          cast<float>(7), ",", cast<double>(2.5f), ",", cast<int>(cast<double>(4)), "\n");
    print("calls:", global_cast, ",", take_int(cast<int>(3.9)), ",", return_cast(4.9), "\n");
    var original:double = 2.75;
    var narrowed:int = cast<int>(original);
    print("source:", original, ",", narrowed, "\n");
    print("once:", cast<int>(next_value()), ",", calls, "\n");
    cast<int>(next_value());
    print("statement:", calls, "\n");

    var leaf:Leaf = new Leaf();
    var base:Base = cast<Base>(leaf);
    var recovered:Leaf = cast<Leaf>(base);
    cast<Leaf>(base).b = 21;
    cast<Leaf>(base).b += 2;
    ++cast<Leaf>(base).c;
    print("objects:", base == leaf, ",", recovered == leaf, ",",
          cast<Leaf>(base).total(), ",", cast<Base>(leaf).identify(), "\n");
    print("members:", cast<Leaf>(base).b, ",", cast<Leaf>(base).c, "\n");

    var missing:Base = null;
    print("null:", cast<Leaf>(missing) == null, ",", cast<Leaf>(null) == null, ",",
          cast<string>(null) == null, ",", cast<window>(null) == null, "\n");
    print("identity:", cast<string>("hello"), ",", cast<bool>(true), ",",
          cast<vector>(vector(1, 2, 3)).z, "\n");
}
