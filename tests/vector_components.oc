var global_vector: vector = vector(10, 20, 30);
var receiver_calls: int = 0;

object Moving {
    var velocity: vector = vector(1, 2, 3);

    func step(): void {
        position.x = 10;
        this.position.y += 2;
        position.z++;
        velocity.z -= 1;
    }
}

object Child extends Moving {}
object Holder {
    var item: Child = new Child();
}
var holder: Holder = new Holder();

func receiver(): Child {
    receiver_calls++;
    return holder.item;
}

func change_other_component(): float {
    holder.item.velocity.y = 99;
    return 2;
}

func make_vector(): vector {
    return vector(6, 7, 8);
}

func change_copy(value: vector): float {
    value.x = 11;
    return value.x;
}

func main(): void {
    var flag: bool = true;
    var local: vector = vector(1, 2, 3);
    local.x = 4;
    local.y += 2;
    local.z *= 2;
    local.x++;
    --local.y;
    print("local:", local.x, ",", local.y, ",", local.z, ",", flag, "\n");
    global_vector.x /= 2;
    global_vector.y %= 6;
    global_vector.z--;
    print("global:", global_vector.x, ",", global_vector.y, ",", global_vector.z, "\n");

    var moving: Moving = new Moving();
    moving.step();
    moving.size.x = 5;
    moving.rotation = 3;
    print("builtin:", moving.position.x, ",", moving.position.y, ",",
          moving.position.z, ",", moving.size.x, ",", moving.rotation, "\n");

    receiver().velocity.x += change_other_component();
    receiver().velocity.z++;
    print("nested:", holder.item.velocity.x, ",", holder.item.velocity.y, ",",
          holder.item.velocity.z, ",", receiver_calls, "\n");
    print("temporary:", vector(3, 4, 5).x, ",", make_vector().y, ",",
          make_vector().z, ",", new Moving().velocity.x, "\n");
    print("copy:", change_copy(local), ",", local.x, "\n");

    local = vector(7, 8, 9);
    local.x = 1.5;
    local.z = local.x + local.y;
    print("replace:", local.x, ",", local.y, ",", local.z, "\n");
    var zero: vector;
    zero.y += 3;
    print("zero:", zero.x, ",", zero.y, ",", zero.z, "\n");
}
